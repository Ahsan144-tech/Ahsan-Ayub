{% comment %}
  Custom Banner Section
  Canvas reference: 3840 x 2340 (Figma frame)
  - Top illustration strip (full width)
  - Bottom-left: text content (heading, subheading, button)
  - Bottom-right: second illustration
  - Ticker bar at the very bottom
{% endcomment %}

{{ 'custom-banner.css' | asset_url | stylesheet_tag }}

<section class="custom-banner" style="--btn-bg: {{ section.settings.button_bg_color }}; --btn-hover-bg: {{ section.settings.button_hover_bg_color }}; --btn-text: {{ section.settings.button_text_color }}; --btn-hover-text: {{ section.settings.button_hover_text_color }}; --ticker-bg: {{ section.settings.ticker_bg_color }}; --ticker-text: {{ section.settings.ticker_text_color }};">
  <div class="custom-banner__canvas">

    {% if section.settings.top_image %}
      <img
        class="custom-banner__top-image"
        src="{{ section.settings.top_image | image_url }}"
        alt=""
        loading="lazy"
        width="{{ section.settings.top_image.width }}"
        height="{{ section.settings.top_image.height }}"
      >
    {% endif %}

    <div class="custom-banner__content">
      {% if section.settings.heading != blank %}
        <h2 class="custom-banner__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="custom-banner__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="custom-banner__button">
          <span class="custom-banner__button-bg"></span>
          <span class="custom-banner__button-label">{{ section.settings.button_label }}</span>
          <span class="custom-banner__button-arrow" aria-hidden="true">
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 1L19 6L14 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.bottom_right_image %}
      <img
        class="custom-banner__bottom-image"
        src="{{ section.settings.bottom_right_image | image_url }}"
        alt=""
        loading="lazy"
        width="{{ section.settings.bottom_right_image.width }}"
        height="{{ section.settings.bottom_right_image.height }}"
      >
    {% endif %}

  </div>

  {% if section.settings.ticker_text != blank %}
    <div class="custom-banner__ticker">
      <p>{{ section.settings.ticker_text }}</p>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
        {
      "type": "color",
      "id": "ticker_bg_color",
      "label": "Ticker background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "ticker_text_color",
      "label": "Ticker text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top illustration strip"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_image",
      "label": "Bottom-right illustration"
    },
    {
      "type": "header",
      "content": "Button Colors"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background (default)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text/arrow (default)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button background (hover)",
      "default": "#F5D547"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button text/arrow (hover)",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}