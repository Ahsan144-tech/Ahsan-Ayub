{% comment %}
  Custom Banner Section
  Canvas reference: 3840 x 2340 (Figma frame)
  - Top illustration strip (full width)
  - Bottom-left: text content (heading, subheading, button)
  - Bottom-right: second illustration
  - Ticker bar at the very bottom
{% endcomment %}

{{ 'custom-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-banner.js' | asset_url }}" defer="defer"></script>

<section class="custom-banner" style="--btn-bg: {{ section.settings.button_bg_color }}; --btn-hover-bg: {{ section.settings.button_hover_bg_color }}; --btn-text: {{ section.settings.button_text_color }}; --btn-hover-text: {{ section.settings.button_hover_text_color }}; --ticker-bg: {{ section.settings.ticker_bg_color }}; --ticker-text: {{ section.settings.ticker_text_color }};">
  <div class="custom-banner__topbar" style="--topbar-bg: {{ section.settings.topbar_bg_color }}; --topbar-btn-bg: {{ section.settings.topbar_button_bg_color }}; --topbar-btn-text: {{ section.settings.topbar_button_text_color }}; --topbar-btn-hover-bg: {{ section.settings.topbar_button_hover_bg_color }}; --topbar-btn-hover-text: {{ section.settings.topbar_button_hover_text_color }};">

    <div class="custom-banner__topbar-row">
      <button type="button" class="custom-banner__topbar-toggle" aria-expanded="false" aria-controls="TopbarPanel-{{ section.id }}">
        <span class="custom-banner__topbar-icon custom-banner__topbar-icon--menu" aria-hidden="true">
          <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 1H20" stroke="currentColor" stroke-width="1.5"/>
            <path d="M0 7H20" stroke="currentColor" stroke-width="1.5"/>
            <path d="M0 13H20" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </span>
        <span class="custom-banner__topbar-icon custom-banner__topbar-icon--close" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L15 15" stroke="currentColor" stroke-width="1.5"/>
            <path d="M15 1L1 15" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </span>
        <span class="visually-hidden">Toggle gift menu</span>
      </button>

      <div class="custom-banner__topbar-brand">
        {% if section.settings.topbar_logo %}
          <img
            src="{{ section.settings.topbar_logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.topbar_logo.width }}"
            height="{{ section.settings.topbar_logo.height }}"
            loading="lazy"
          >
        {% elsif section.settings.topbar_brand_text != blank %}
          <span>{{ section.settings.topbar_brand_text }}</span>
        {% endif %}
      </div>

      {% if section.settings.topbar_tagline != blank %}
        <p class="custom-banner__topbar-tagline custom-banner__topbar-tagline--desktop">{{ section.settings.topbar_tagline }}</p>
      {% endif %}

      {% if section.settings.topbar_button_label != blank %}
        <a href="{{ section.settings.topbar_button_link }}" class="custom-banner__topbar-button custom-banner__topbar-button--desktop">
          <span class="custom-banner__topbar-button-bg"></span>
          <span class="custom-banner__topbar-button-label">{{ section.settings.topbar_button_label }}</span>
          <span class="custom-banner__topbar-button-arrow" aria-hidden="true">
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 1L19 6L14 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endif %}
    </div>

    <div class="custom-banner__topbar-panel" id="TopbarPanel-{{ section.id }}" hidden>
      {% if section.settings.topbar_tagline != blank %}
        <p class="custom-banner__topbar-tagline">{{ section.settings.topbar_tagline }}</p>
      {% endif %}

      {% if section.settings.topbar_button_label != blank %}
        <a href="{{ section.settings.topbar_button_link }}" class="custom-banner__topbar-button">
          <span class="custom-banner__topbar-button-bg"></span>
          <span class="custom-banner__topbar-button-label">{{ section.settings.topbar_button_label }}</span>
          <span class="custom-banner__topbar-button-arrow" aria-hidden="true">
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 1L19 6L14 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endif %}
    </div>

  </div>
  
  <div class="custom-banner__canvas">

    {% if section.settings.top_image %}
      <img
        class="custom-banner__top-image"
        src="{{ section.settings.top_image | image_url }}"
        alt=""
        loading="lazy"
        width="{{ section.settings.top_image.width }}"
        height="{{ section.settings.top_image.height }}"
      >
    {% endif %}

    <div class="custom-banner__content">
            {% if section.settings.heading != blank %}
        <h2 class="custom-banner__heading custom-banner__heading--desktop">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.heading_mobile != blank or section.settings.heading != blank %}
        <h2 class="custom-banner__heading custom-banner__heading--mobile">
          {{ section.settings.heading_mobile | default: section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="custom-banner__subheading custom-banner__subheading--desktop">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.subheading_mobile != blank or section.settings.subheading != blank %}
        <p class="custom-banner__subheading custom-banner__subheading--mobile">
          {{ section.settings.subheading_mobile | default: section.settings.subheading }}
        </p>
      {% endif %}


      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="custom-banner__button">
          <span class="custom-banner__button-bg"></span>
          <span class="custom-banner__button-label">{{ section.settings.button_label }}</span>
          <span class="custom-banner__button-arrow" aria-hidden="true">
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 1L19 6L14 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 6H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.bottom_right_image %}
      <img
        class="custom-banner__bottom-image"
        src="{{ section.settings.bottom_right_image | image_url }}"
        alt=""
        loading="lazy"
        width="{{ section.settings.bottom_right_image.width }}"
        height="{{ section.settings.bottom_right_image.height }}"
      >
    {% endif %}

  </div>

  {% if section.settings.ticker_text != blank %}
    <div class="custom-banner__ticker">
      <p>{{ section.settings.ticker_text }}</p>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "image_picker",
      "id": "topbar_logo",
      "label": "Logo image (overrides text if uploaded)"
    },
    {
      "type": "text",
      "id": "topbar_brand_text",
      "label": "Brand text (used if no logo uploaded)",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "topbar_tagline",
      "label": "Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "topbar_button_label",
      "label": "Button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "topbar_button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "topbar_bg_color",
      "label": "Top bar background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "topbar_button_bg_color",
      "label": "Button background (default)",
      "default": "#F5D547"
    },
    {
      "type": "color",
      "id": "topbar_button_text_color",
      "label": "Button text (default)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "topbar_button_hover_bg_color",
      "label": "Button background (hover)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "topbar_button_hover_text_color",
      "label": "Button text (hover)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
        {
      "type": "text",
      "id": "heading_mobile",
      "label": "Heading (mobile, optional — falls back to desktop heading if blank)"
    },
    {
      "type": "textarea",
      "id": "subheading_mobile",
      "label": "Subheading (mobile, optional — falls back to desktop subheading if blank)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
        {
      "type": "color",
      "id": "ticker_bg_color",
      "label": "Ticker background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "ticker_text_color",
      "label": "Ticker text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top illustration strip"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_image",
      "label": "Bottom-right illustration"
    },
    {
      "type": "header",
      "content": "Button Colors"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background (default)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text/arrow (default)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button background (hover)",
      "default": "#F5D547"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button text/arrow (hover)",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}