{% comment %}
  Custom Grid Section
  - Editable heading
  - 6 blocks, each with a merchant-selected product
  - Each block shows one product image with a "+" trigger icon (customizable position)
  - Hover (desktop): shows a small preview card (image, title, price)
  - Click (desktop) / Tap (mobile): opens the full product popup modal
  - Popup renders variants (color/size) dynamically from product data
  - Special rule: selecting Black + Medium also adds "Soft Winter Jacket" to cart
  - Desktop: 3 columns x 2 rows, 30px gap | Mobile: 2 columns x 3 rows, 20px gap
{% endcomment %}

{{ 'custom-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-grid.js' | asset_url }}" defer="defer"></script>

<section class="custom-grid" data-section-id="{{ section.id }}">

  {% if section.settings.heading != blank %}
    <h2 class="custom-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="custom-grid__list">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="custom-grid__item" {{ block.shopify_attributes }}>

        {% if product %}
          <img
            class="custom-grid__image"
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title }}"
            loading="lazy"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >

          <button
            type="button"
            class="custom-grid__trigger"
            style="left: {{ block.settings.icon_x }}%; top: {{ block.settings.icon_y }}%;"
            data-grid-trigger
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price | money }}"
            data-product-image="{{ product.featured_image | image_url: width: 200 }}"
            aria-haspopup="dialog"
          >
            <span aria-hidden="true">+</span>
            <span class="visually-hidden">View {{ product.title }}</span>
          </button>

          <div class="custom-grid__hovercard" data-grid-hovercard hidden>
            <img class="custom-grid__hovercard-image" src="{{ product.featured_image | image_url: width: 200 }}" alt="" width="80" height="80">
            <div class="custom-grid__hovercard-info">
              <p class="custom-grid__hovercard-title">{{ product.title }}</p>
              <p class="custom-grid__hovercard-price">{{ product.price | money }}</p>
            </div>
          </div>
        {% else %}
          <div class="custom-grid__placeholder">Select a product</div>
        {% endif %}

      </div>
    {% endfor %}
  </div>

  {% comment %} Single shared modal, populated dynamically by JS when a trigger is clicked {% endcomment %}
  <div class="custom-grid__modal" data-grid-modal hidden aria-hidden="true" role="dialog" aria-modal="true">
    <div class="custom-grid__modal-overlay" data-grid-modal-close></div>
    <div class="custom-grid__modal-content">
      <button type="button" class="custom-grid__modal-close" data-grid-modal-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L17 17" stroke="currentColor" stroke-width="1.5"/>
          <path d="M17 1L1 17" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>

      <div class="custom-grid__modal-body">
        <div class="custom-grid__modal-image-wrap">
          <img class="custom-grid__modal-image" data-grid-modal-image src="" alt="">
        </div>

        <div